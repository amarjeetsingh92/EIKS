# ── LLM Provider ─────────────────────────────────────────────────────────────
# Choose one: anthropic | openai | ollama
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=your-anthropic-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic model (used when LLM_PROVIDER=anthropic)
ANTHROPIC_MODEL=claude-opus-4-6

# OpenAI model (used when LLM_PROVIDER=openai)
OPENAI_MODEL=gpt-4o

# Ollama (used when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ── Embeddings ────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384

# ── Vector Store ──────────────────────────────────────────────────────────────
# Choose one: faiss | qdrant
VECTOR_BACKEND=faiss

FAISS_INDEX_PATH=./data/faiss_index

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=rag_documents

RETRIEVAL_TOP_K=5

# ── Chunking ──────────────────────────────────────────────────────────────────
# Choose one: sliding_window | semantic
CHUNKING_STRATEGY=sliding_window
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ── OCR ───────────────────────────────────────────────────────────────────────
# Path to tesseract binary (find with: which tesseract)
TESSERACT_CMD=/usr/bin/tesseract
OCR_LANGUAGE=eng
OCR_DPI=300

# ── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
